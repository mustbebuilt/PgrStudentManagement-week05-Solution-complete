@model IReadOnlyList<PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.AcademicSupervisor>

@{
    ViewData["Title"] = "Academic Supervisors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Academic Supervisors</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Create Academic Supervisor
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No academic supervisors found
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Staff number</th>
                <th>Name</th>
                <th>Email address</th>
                <th>Employment type</th>
                <th>Eligible roles</th>
                <th>
                    <span class="visually-hidden">Actions</span>
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var supervisor in Model)
            {
                <tr>
                    <td>@supervisor.StaffNumber</td>

                    <td>
                        @supervisor.FirstName
                        @supervisor.LastName
                    </td>

                    <td>
                        @if (string.IsNullOrWhiteSpace(
                            supervisor.EmailAddress))
                        {
                            <span class="text-muted">
                                Not recorded
                            </span>
                        }
                        else
                        {
                            <a href="mailto:@supervisor.EmailAddress">
                                @supervisor.EmailAddress
                            </a>
                        }
                    </td>

                    <td>
                        @supervisor.EmploymentType
                    </td>

                    <td>
                        @if (supervisor.EligibleRoles.Count == 0)
                        {
                            <span class="text-muted">
                                No eligible roles recorded
                            </span>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var role in
                                    supervisor.EligibleRoles
                                        .OrderBy(role => role))
                                {
                                    <li>@role</li>
                                }
                            </ul>
                        }
                    </td>

                    <td class="text-end">
                        <a asp-action="Details"
                           asp-route-staffNumber=
                               "@supervisor.StaffNumber"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}