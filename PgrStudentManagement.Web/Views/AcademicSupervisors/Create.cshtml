@model PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.CreateAcademicSupervisorViewModel

@using PgrStudentManagement.Web.Modules.AcademicSupervisors.Models

@{
    ViewData["Title"] = "Create Academic Supervisor";
}

<h1>Create Academic Supervisor</h1>

<p>
    Enter the supervisor information and select the roles for which
    they are currently eligible.
</p>

<form asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"></div>

    <div class="mb-3">
        <label asp-for="StaffNumber"
               class="form-label">
            Staff number
        </label>

        <input asp-for="StaffNumber"
               class="form-control" />

        <span asp-validation-for="StaffNumber"
              class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FirstName"
                   class="form-label">
                First name
            </label>

            <input asp-for="FirstName"
                   class="form-control" />

            <span asp-validation-for="FirstName"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="LastName"
                   class="form-label">
                Last name
            </label>

            <input asp-for="LastName"
                   class="form-control" />

            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="EmailAddress"
               class="form-label">
            Email address
        </label>

        <input asp-for="EmailAddress"
               type="email"
               class="form-control" />

        <span asp-validation-for="EmailAddress"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmploymentType"
               class="form-label">
            Employment type
        </label>

        <select asp-for="EmploymentType"
                asp-items=
                    "Html.GetEnumSelectList<SupervisorEmploymentType>()"
                class="form-select">
        </select>

        <span asp-validation-for="EmploymentType"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="TrainingCompleted"
               class="form-check-input" />

        <label asp-for="TrainingCompleted"
               class="form-check-label">
            Required supervisor training completed
        </label>
    </div>

    <fieldset class="mb-4">
        <legend class="fs-5">
            Eligible supervisory roles
        </legend>

        @foreach (var role in
            Enum.GetValues<SupervisoryRole>())
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       id="eligible-role-@role"
                       name="EligibleRoles"
                       value="@role"
                       checked=
                           "@Model.EligibleRoles.Contains(role)" />

                <label class="form-check-label"
                       for="eligible-role-@role">
                    @role
                </label>
            </div>
        }
    </fieldset>

    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}