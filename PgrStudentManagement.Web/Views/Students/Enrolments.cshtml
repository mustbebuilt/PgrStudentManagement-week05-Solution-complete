@model IReadOnlyList<PgrStudentManagement.Web.Modules.Students.Models.Enrolment>

@{
    ViewData["Title"] = "Student Enrolments";
}

<h1>Student Enrolments</h1>

<p>Student number: @ViewData["StudentNumber"]</p>

@if (Model.Count == 0)
{
    <p class="alert alert-info">
        @(ViewData["Message"] ?? "No enrolments found")
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Programme</th>
                <th>Start date</th>
                <th>Expected end date</th>
                <th>Mode of study</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var enrolment in Model)
        {
            <tr>
                <td>@enrolment.ProgrammeCode</td>
                <td>@enrolment.StartDate.ToString("dd MMMM yyyy")</td>
                <td>
                    @(enrolment.ExpectedEndDate?.ToString("dd MMMM yyyy") ?? "Not recorded")
                </td>
                <td>@enrolment.ModeOfStudy</td>
                <td>@enrolment.Status</td>
            </tr>
        }
        </tbody>
    </table>
}

<p>
    <a asp-action="Index">Return to students</a>
</p>
