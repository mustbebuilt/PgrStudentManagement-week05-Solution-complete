@model PgrStudentManagement.Web.Modules.Students.Models.Student

@{
    ViewData["Title"] =
        "Update Expected Thesis Submission Date";
}

<h1>Update Expected Thesis Submission Date</h1>

<p>
    <strong>@Model.StudentNumber:</strong>
    @Model.FullName
</p>

<form asp-action="EditExpectedSubmissionDate"
      method="post">
    <input type="hidden"
           name="studentNumber"
           value="@Model.StudentNumber" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label for="expectedSubmissionDate" class="form-label">
            Expected submission date
        </label>

        <input id="expectedSubmissionDate"
               name="expectedSubmissionDate"
               type="date"
               value="@Model.ExpectedSubmissionDate?.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="ThesisDetails"
       asp-route-studentNumber="@Model.StudentNumber"
       class="btn btn-secondary">
        Cancel
    </a>
</form>