@model IReadOnlyList<PgrStudentManagement.Web.Modules.ResearchActivities.Models.ResearchActivity>
@using PgrStudentManagement.Web.Modules.ResearchActivities.Models

@{
    ViewData["Title"] = "Research Activity Log";
}

<h1>Research Activity Log</h1>

<p>Student number: @ViewData["StudentNumber"]</p>

@if (Model.Count == 0)
{
    <p class="alert alert-info">
        @(ViewData["Message"] ?? "No research activities found")
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Title</th>
                <th>Tags</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var activity in Model)
        {
            <tr>
                <td>@activity.ActivityDate.ToString("dd MMMM yyyy")</td>
                <td>@activity.ActivityType</td>
                <td>@activity.Title</td>
                <td>
                    @if (activity.Tags != null && activity.Tags.Count > 0)
                    {
                        @string.Join(", ", activity.Tags)
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </td>
                <td>
                    @switch (activity.ActivityType)
                    {
                        case ResearchActivityType.ResearchReflection:
                            if (activity.Details != null && activity.Details.TryGetValue("summary", out var summary))
                            {
                                <div><strong>Summary:</strong> @summary</div>
                            }
                            if (activity.Details != null && activity.Details.TryGetValue("nextSteps", out var nextStepsObj))
                            {
                                var nextSteps = nextStepsObj as System.Collections.IEnumerable;
                                if (nextSteps != null && !(nextSteps is string))
                                {
                                    var items = new List<string>();
                                    foreach (var item in nextSteps)
                                    {
                                        items.Add(item?.ToString() ?? string.Empty);
                                    }
                                    <div><strong>Next Steps:</strong> @string.Join(", ", items)</div>
                                }
                            }
                            break;

                        case ResearchActivityType.SupervisionMeeting:
                            if (activity.Details != null && activity.Details.TryGetValue("discussion", out var discussion))
                            {
                                <div><strong>Discussion:</strong> @discussion</div>
                            }
                            if (activity.Details != null && activity.Details.TryGetValue("actions", out var actionsObj))
                            {
                                var actions = actionsObj as System.Collections.IEnumerable;
                                if (actions != null && !(actions is string))
                                {
                                    var items = new List<string>();
                                    foreach (var item in actions)
                                    {
                                        items.Add(item?.ToString() ?? string.Empty);
                                    }
                                    <div><strong>Actions:</strong> @string.Join(", ", items)</div>
                                }
                            }
                            break;

                        case ResearchActivityType.ConferenceAttendance:
                            if (activity.Details != null && activity.Details.TryGetValue("conferenceName", out var confName))
                            {
                                <div><strong>Conference:</strong> @confName</div>
                            }
                            if (activity.Details != null && activity.Details.TryGetValue("location", out var location))
                            {
                                <div><strong>Location:</strong> @location</div>
                            }
                            if (activity.Details != null && activity.Details.TryGetValue("presentationTitle", out var presTitle))
                            {
                                <div><strong>Presentation:</strong> @presTitle</div>
                            }
                            break;

                        default:
                            if (activity.Details != null)
                            {
                                foreach (var kvp in activity.Details)
                                {
                                    <div><strong>@kvp.Key:</strong> @kvp.Value</div>
                                }
                            }
                            break;
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<p>
    <a asp-controller="Students" asp-action="Index">Return to students</a>
</p>
